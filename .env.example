# UrbanGraph Intelligence - Local Environment Configuration Template
# Copy this file to .env before starting local development

# Environment & Server
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Application Security
ENERGRAPH_DEMO_SECRET_KEY=change_this_to_a_secure_random_hex_string_in_production
ENERGRAPH_DEMO_FRONTEND_ORIGIN=http://127.0.0.1:8000

# Authentication & Tokens
ENERGRAPH_SECURITY_DIR=./security
TOKEN_EXPIRY_HOURS=24

# Model & Fixture Paths
MODEL_CHECKPOINT_PATH=./src/urbangraph/checkpoints/urbangraphformer_synth.pt
FIXTURES_DIR=./src/urbangraph/fixtures
DEFAULT_NETWORK_FIXTURE=eg006

# Optimization Engine
HIGHS_SOLVER_TIME_LIMIT=60.0
HIGHS_MIP_GAP=0.01
