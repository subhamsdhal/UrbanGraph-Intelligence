# UrbanGraph Intelligence - Production Environment Configuration Template
# Mandatory for staging, cloud hosting, and production deployments
# Generate strong 32+ byte cryptographic keys before deployment

# Environment Identifier
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8080
DEBUG=false
LOG_LEVEL=WARNING

# Strict Application Security
# MUST be set to a high-entropy secret (e.g., openssl rand -hex 32)
ENERGRAPH_DEMO_SECRET_KEY=
# MUST match your authoritative external domain or reverse proxy origin
ENERGRAPH_DEMO_FRONTEND_ORIGIN=https://grid.example.com

# Centralized Security Database (Durable Mount)
ENERGRAPH_SECURITY_DIR=/app/security
TOKEN_EXPIRY_HOURS=8

# Pre-seeded Administrative Token (Leave empty to generate dynamically)
INITIAL_ADMIN_TOKEN=

# Model & Optimization
MODEL_CHECKPOINT_PATH=/app/urbangraph/checkpoints/urbangraphformer_synth.pt
FIXTURES_DIR=/app/urbangraph/fixtures
HIGHS_SOLVER_TIME_LIMIT=30.0

# Ingress Proxy Rate Limiting
RATE_LIMIT_GENERAL=100
RATE_LIMIT_ADMIN=5
